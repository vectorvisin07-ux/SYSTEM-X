#!/usr/bin/env python3.14
"""Self-relative public System X launcher."""

from __future__ import annotations

from pathlib import Path
import sys


ROOT = Path(__file__).resolve(strict=True).parent
sys.path.insert(0, str(ROOT / "bootstrap"))

from system_x_bootstrap.front_door import main  # noqa: E402


if __name__ == "__main__":
    if len(sys.argv) >= 2 and sys.argv[1] == "verify-code":
        from system_x_bootstrap.code_verify import main as verify_main
        raise SystemExit(verify_main(ROOT, machine=len(sys.argv) == 3 and sys.argv[2] == "--json"))
    raise SystemExit(main())
