{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system-x.inspector-gguf-qualification-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_id",
    "transaction_id",
    "created_utc",
    "completed_utc",
    "inspection",
    "input_decision",
    "requested_profile",
    "installed_tuple",
    "incumbent",
    "candidate_runtime",
    "checks",
    "supported_profiles",
    "observed_capabilities",
    "result_class",
    "reason_codes",
    "restoration",
    "cleanup",
    "validity_predicate",
    "result_identity"
  ],
  "properties": {
    "schema_version": {
      "const": "system-x.inspector-gguf-qualification-result.v1"
    },
    "qualification_id": {
      "type": "string",
      "pattern": "^qualification-[0-9]{8}T[0-9]{12}Z-[0-9a-f]{16}$"
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1
    },
    "created_utc": {
      "type": "string",
      "minLength": 1
    },
    "completed_utc": {
      "type": "string",
      "minLength": 1
    },
    "inspection": {
      "$ref": "#/$defs/inspection"
    },
    "input_decision": {
      "$ref": "#/$defs/inputDecision"
    },
    "requested_profile": {
      "$ref": "#/$defs/profile"
    },
    "installed_tuple": {
      "$ref": "#/$defs/installedTuple"
    },
    "incumbent": {
      "$ref": "#/$defs/incumbent"
    },
    "candidate_runtime": {
      "$ref": "#/$defs/candidateRuntime"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "supported_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "observed_capabilities": {
      "$ref": "#/$defs/observedCapabilities"
    },
    "result_class": {
      "enum": [
        "SUPPORTED_FOR_CURRENT_TUPLE",
        "PARTIALLY_SUPPORTED",
        "UNSUPPORTED",
        "REJECTED",
        "QUALIFICATION_FAILED_CLEAN",
        "QUALIFICATION_FAIL_CLOSED"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "restoration": {
      "$ref": "#/$defs/restoration"
    },
    "cleanup": {
      "$ref": "#/$defs/cleanup"
    },
    "validity_predicate": {
      "$ref": "#/$defs/validityPredicate"
    },
    "result_identity": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile": {
      "enum": [
        "CORE_CHAT",
        "EXTENDED_CHAT",
        "AGENT",
        "FULL_PRODUCT"
      ]
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspection_id",
        "inspection_result_identity",
        "artifact_identity",
        "artifact_size",
        "physical_format",
        "model_type",
        "architecture",
        "quantization_summary",
        "tokenizer_identity",
        "chat_template_identity"
      ],
      "properties": {
        "inspection_id": {
          "type": "string",
          "minLength": 1
        },
        "inspection_result_identity": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_identity": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_size": {
          "type": "integer",
          "minimum": 1
        },
        "physical_format": {
          "const": "GGUF"
        },
        "model_type": {
          "const": "model"
        },
        "architecture": {
          "$ref": "#/$defs/nullableString"
        },
        "quantization_summary": {
          "$ref": "#/$defs/quantizationSummary"
        },
        "tokenizer_identity": {
          "$ref": "#/$defs/nullableSha256"
        },
        "chat_template_identity": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "inputDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "decision_result_identity",
        "capability_result",
        "reason_code"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "decision_result_identity": {
          "$ref": "#/$defs/sha256"
        },
        "capability_result": {
          "enum": [
            "RUNTIME_SMOKE_REQUIRED",
            "SUPPORTED"
          ]
        },
        "reason_code": {
          "enum": [
            "GGUF_RUNTIME_SMOKE_REQUIRED",
            "GGUF_ACCEPTED_CAPABILITY_MATCH"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capability_result": {
                "const": "RUNTIME_SMOKE_REQUIRED"
              }
            }
          },
          "then": {
            "properties": {
              "reason_code": {
                "const": "GGUF_RUNTIME_SMOKE_REQUIRED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability_result": {
                "const": "SUPPORTED"
              }
            }
          },
          "then": {
            "properties": {
              "reason_code": {
                "const": "GGUF_ACCEPTED_CAPABILITY_MATCH"
              }
            }
          }
        }
      ]
    },
    "quantizationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "general_file_type",
        "quantization_version",
        "mixed_tensor_types",
        "tensor_types"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/nullableString"
        },
        "general_file_type": {
          "type": [
            "integer",
            "null"
          ]
        },
        "quantization_version": {
          "type": [
            "integer",
            "null"
          ]
        },
        "mixed_tensor_types": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tensor_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "installedTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_capability_record_identity",
        "capability_binding_identity",
        "installed_tuple_verification_identity",
        "llama_cpp_commit",
        "llama_server_sha256",
        "branch_controller_identity",
        "api_service_controller_identity",
        "api_source_manifest_identity",
        "supervisor_identity"
      ],
      "properties": {
        "branch_capability_record_identity": {
          "$ref": "#/$defs/sha256"
        },
        "capability_binding_identity": {
          "$ref": "#/$defs/sha256"
        },
        "installed_tuple_verification_identity": {
          "$ref": "#/$defs/sha256"
        },
        "llama_cpp_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "llama_server_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "branch_controller_identity": {
          "$ref": "#/$defs/sha256"
        },
        "api_service_controller_identity": {
          "$ref": "#/$defs/sha256"
        },
        "api_source_manifest_identity": {
          "$ref": "#/$defs/sha256"
        },
        "supervisor_identity": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "warmEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_model_id",
        "artifact_version_id",
        "capability_manifest_identity",
        "health_state"
      ],
      "properties": {
        "public_model_id": {
          "$ref": "#/$defs/nullableString"
        },
        "artifact_version_id": {
          "$ref": "#/$defs/nullableString"
        },
        "capability_manifest_identity": {
          "$ref": "#/$defs/nullableSha256"
        },
        "health_state": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "nullableWarmEvidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/warmEvidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "incumbent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "default_alias",
        "public_model_id",
        "artifact_version_id",
        "capability_manifest_identity",
        "managed_location_identity",
        "warm_before",
        "warm_after"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "default_alias": {
          "$ref": "#/$defs/nullableString"
        },
        "public_model_id": {
          "$ref": "#/$defs/nullableString"
        },
        "artifact_version_id": {
          "$ref": "#/$defs/nullableString"
        },
        "capability_manifest_identity": {
          "$ref": "#/$defs/nullableSha256"
        },
        "managed_location_identity": {
          "$ref": "#/$defs/nullableSha256"
        },
        "warm_before": {
          "$ref": "#/$defs/nullableWarmEvidence"
        },
        "warm_after": {
          "$ref": "#/$defs/nullableWarmEvidence"
        }
      }
    },
    "candidateRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managed_relative_path",
        "registry_states_observed",
        "public_model_id",
        "artifact_version_id",
        "capability_manifest_identity"
      ],
      "properties": {
        "managed_relative_path": {
          "$ref": "#/$defs/nullableString"
        },
        "registry_states_observed": {
          "type": "array",
          "items": {
            "enum": [
              "REGISTERED",
              "PROBING",
              "READY",
              "REJECTED",
              "UNAVAILABLE",
              "REMOVED"
            ]
          }
        },
        "public_model_id": {
          "$ref": "#/$defs/nullableString"
        },
        "artifact_version_id": {
          "$ref": "#/$defs/nullableString"
        },
        "capability_manifest_identity": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "nullableUsage": {
      "oneOf": [
        {
          "$ref": "#/$defs/usage"
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilityObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "available",
        "accurately_gated"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "available": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "accurately_gated": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "nullableCapabilityObservation": {
      "oneOf": [
        {
          "$ref": "#/$defs/capabilityObservation"
        },
        {
          "type": "null"
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_name",
        "required",
        "protocol_family",
        "status",
        "request_id",
        "http_status",
        "finish_or_terminal_state",
        "usage",
        "capability_observation",
        "bounded_evidence_identity",
        "reason_code"
      ],
      "properties": {
        "check_name": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "protocol_family": {
          "enum": [
            "system_x",
            "openai",
            "messages",
            "heychat",
            "manager",
            "registry",
            "none"
          ]
        },
        "status": {
          "enum": [
            "PASSED",
            "PASSED_AVAILABLE",
            "PASSED_GATED_UNAVAILABLE",
            "UNAVAILABLE",
            "FAILED",
            "NOT_APPLICABLE",
            "NOT_REQUESTED"
          ]
        },
        "request_id": {
          "$ref": "#/$defs/nullableString"
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "finish_or_terminal_state": {
          "$ref": "#/$defs/nullableString"
        },
        "usage": {
          "$ref": "#/$defs/nullableUsage"
        },
        "capability_observation": {
          "$ref": "#/$defs/nullableCapabilityObservation"
        },
        "bounded_evidence_identity": {
          "$ref": "#/$defs/nullableSha256"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observedCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "gated_unavailable",
        "unavailable"
      ],
      "properties": {
        "available": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gated_unavailable": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unavailable": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "restoration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_state",
        "default_unchanged",
        "incumbent_ready",
        "incumbent_warm",
        "waiting_for_model",
        "recovery_idle",
        "proved"
      ],
      "properties": {
        "required_state": {
          "enum": [
            "READY",
            "WAITING_FOR_MODEL"
          ]
        },
        "default_unchanged": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "incumbent_ready": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "incumbent_warm": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "waiting_for_model": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "recovery_idle": {
          "type": "boolean"
        },
        "proved": {
          "type": "boolean"
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "staging_absent",
        "managed_target_absent",
        "registry_location_removed",
        "source_removed_if_packet_owned",
        "ownership_certain"
      ],
      "properties": {
        "staging_absent": {
          "type": "boolean"
        },
        "managed_target_absent": {
          "type": "boolean"
        },
        "registry_location_removed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source_removed_if_packet_owned": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "ownership_certain": {
          "type": "boolean"
        }
      }
    },
    "validityPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_identity",
        "capability_record_identity",
        "binding_identity",
        "installed_tuple_verification_identity",
        "llama_cpp_commit",
        "llama_server_sha256",
        "connected_source_identity",
        "predicate_identity"
      ],
      "properties": {
        "artifact_identity": {
          "$ref": "#/$defs/sha256"
        },
        "capability_record_identity": {
          "$ref": "#/$defs/sha256"
        },
        "binding_identity": {
          "$ref": "#/$defs/sha256"
        },
        "installed_tuple_verification_identity": {
          "$ref": "#/$defs/sha256"
        },
        "llama_cpp_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "llama_server_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "connected_source_identity": {
          "$ref": "#/$defs/sha256"
        },
        "predicate_identity": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
