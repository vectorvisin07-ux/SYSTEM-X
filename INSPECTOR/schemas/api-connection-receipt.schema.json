{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system-x.inspector-api-connection-receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "receipt_identity",
    "generated_utc",
    "receipt_source",
    "deployment_id",
    "deployment_result_identity",
    "service",
    "connections",
    "model",
    "authentication",
    "capabilities",
    "proof",
    "lifecycle",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "system-x.inspector-api-connection-receipt.v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^connection-[0-9]{8}T[0-9]{12}Z-[0-9a-f]{16}$"
    },
    "receipt_identity": {
      "$ref": "#/$defs/sha256"
    },
    "generated_utc": {
      "type": "string",
      "minLength": 1
    },
    "receipt_source": {
      "enum": [
        "DEPLOY_GGUF",
        "EXISTING_ACCEPTED_READY_BASELINE"
      ]
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1
    },
    "deployment_result_identity": {
      "$ref": "#/$defs/nullableSha256"
    },
    "service": {
      "$ref": "#/$defs/service"
    },
    "connections": {
      "$ref": "#/$defs/connections"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "authentication": {
      "$ref": "#/$defs/authentication"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "proof": {
      "$ref": "#/$defs/proof"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stateValue": {
      "type": [
        "boolean",
        "string",
        "null"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_origin",
        "service_available",
        "inference_ready",
        "service_readiness",
        "model_service_state",
        "desired_state",
        "always_on",
        "authentication_required"
      ],
      "properties": {
        "public_origin": {
          "type": "string",
          "pattern": "^https?://(?:127(?:\\.[0-9]{1,3}){3}|\\[::1\\]):[0-9]{1,5}$"
        },
        "service_available": {
          "type": "boolean"
        },
        "inference_ready": {
          "type": "boolean"
        },
        "service_readiness": {
          "enum": [
            "READY",
            "WAITING_FOR_MODEL",
            "DEGRADED",
            "STOPPED"
          ]
        },
        "model_service_state": {
          "enum": [
            "READY",
            "WAITING_FOR_MODEL",
            "DEGRADED",
            "STOPPED"
          ]
        },
        "desired_state": {
          "enum": [
            "RUNNING",
            "STOPPED"
          ]
        },
        "always_on": {
          "type": "boolean"
        },
        "authentication_required": {
          "type": "boolean"
        }
      }
    },
    "systemXNativeConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_family",
        "base_url",
        "endpoint_semantics",
        "model_reference",
        "authentication",
        "endpoints"
      ],
      "properties": {
        "protocol_family": {
          "const": "system_x_native"
        },
        "base_url": {
          "type": "string",
          "pattern": "^https?://(?:127(?:\\.[0-9]{1,3}){3}|\\[::1\\]):[0-9]{1,5}$"
        },
        "endpoint_semantics": {
          "const": "base_url_relative"
        },
        "model_reference": {
          "type": "string",
          "minLength": 1
        },
        "authentication": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "const": "x-api-key"
            },
            {
              "const": "Authorization Bearer"
            }
          ],
          "items": false
        },
        "endpoints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "health",
            "version",
            "models",
            "model_detail",
            "generate",
            "chat",
            "responses",
            "count_tokens"
          ],
          "properties": {
            "health": { "const": "/system/v1/health" },
            "version": { "const": "/system/v1/version" },
            "models": { "const": "/system/v1/models" },
            "model_detail": { "const": "/system/v1/models/{model_id}" },
            "generate": { "const": "/system/v1/generate" },
            "chat": { "const": "/system/v1/chat" },
            "responses": { "const": "/system/v1/responses" },
            "count_tokens": { "const": "/system/v1/tokens/count" }
          }
        }
      }
    },
    "openAICompatibleConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_family",
        "base_url",
        "endpoint_semantics",
        "model_reference",
        "authentication",
        "endpoints"
      ],
      "properties": {
        "protocol_family": { "const": "openai_compatible" },
        "base_url": {
          "type": "string",
          "pattern": "^https?://(?:127(?:\\.[0-9]{1,3}){3}|\\[::1\\]):[0-9]{1,5}/v1$"
        },
        "endpoint_semantics": { "const": "base_url_relative" },
        "model_reference": { "type": "string", "minLength": 1 },
        "authentication": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            { "const": "Authorization Bearer" }
          ],
          "items": false
        },
        "endpoints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "models",
            "completions",
            "chat_completions",
            "responses"
          ],
          "properties": {
            "models": { "const": "/models" },
            "completions": { "const": "/completions" },
            "chat_completions": { "const": "/chat/completions" },
            "responses": { "const": "/responses" }
          }
        }
      }
    },
    "messagesCompatibleConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_family",
        "base_url",
        "endpoint_semantics",
        "model_reference",
        "authentication",
        "compatibility_version",
        "required_headers",
        "endpoints"
      ],
      "properties": {
        "protocol_family": { "const": "messages_compatible" },
        "base_url": {
          "type": "string",
          "pattern": "^https?://(?:127(?:\\.[0-9]{1,3}){3}|\\[::1\\]):[0-9]{1,5}$"
        },
        "endpoint_semantics": { "const": "base_url_relative" },
        "model_reference": { "type": "string", "minLength": 1 },
        "authentication": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            { "const": "x-api-key" }
          ],
          "items": false
        },
        "compatibility_version": { "const": "2023-06-01" },
        "required_headers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["anthropic-version"],
          "properties": {
            "anthropic-version": { "const": "2023-06-01" }
          }
        },
        "endpoints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["models", "messages", "count_tokens"],
          "properties": {
            "models": { "const": "/v1/models" },
            "messages": { "const": "/v1/messages" },
            "count_tokens": { "const": "/v1/messages/count_tokens" }
          }
        }
      }
    },
    "connections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_x_native",
        "openai_compatible",
        "messages_compatible"
      ],
      "properties": {
        "system_x_native": {
          "$ref": "#/$defs/systemXNativeConnection"
        },
        "openai_compatible": {
          "$ref": "#/$defs/openAICompatibleConnection"
        },
        "messages_compatible": {
          "$ref": "#/$defs/messagesCompatibleConnection"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommended_reference",
        "default_alias",
        "resolved_immutable_model_id",
        "source_label",
        "physical_architecture",
        "physical_model_type",
        "official_checkpoint_attested",
        "artifact_sha256",
        "artifact_version_id",
        "capability_manifest_identity",
        "model_state",
        "warm",
        "context_window_tokens",
        "maximum_output_tokens"
      ],
      "properties": {
        "recommended_reference": {
          "type": "string",
          "minLength": 1
        },
        "default_alias": {
          "type": "string",
          "minLength": 1
        },
        "resolved_immutable_model_id": {
          "type": "string",
          "minLength": 1
        },
        "source_label": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "physical_architecture": {
          "type": [
            "string",
            "null"
          ]
        },
        "physical_model_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "official_checkpoint_attested": {
          "const": false
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_version_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_manifest_identity": {
          "$ref": "#/$defs/sha256"
        },
        "model_state": {
          "enum": [
            "ready",
            "registered",
            "probing",
            "unavailable"
          ]
        },
        "warm": {
          "type": "boolean"
        },
        "context_window_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maximum_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "accepted_schemes",
        "non_secret_key_id",
        "raw_api_key_returned"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "accepted_schemes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "x-api-key",
              "Authorization Bearer"
            ]
          }
        },
        "non_secret_key_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "raw_api_key_returned": {
          "const": false
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_families",
        "streaming",
        "token_counting",
        "reasoning_output",
        "reasoning_control",
        "tool_calling",
        "structured_output",
        "context_window_tokens"
      ],
      "properties": {
        "protocol_families": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "system_x_native",
              "openai_compatible",
              "messages_compatible"
            ]
          }
        },
        "streaming": {
          "$ref": "#/$defs/stateValue"
        },
        "token_counting": {
          "enum": [
            "available",
            "not_tested",
            "unavailable",
            "not_exposed"
          ]
        },
        "reasoning_output": {
          "$ref": "#/$defs/stateValue"
        },
        "reasoning_control": {
          "$ref": "#/$defs/stateValue"
        },
        "tool_calling": {
          "$ref": "#/$defs/stateValue"
        },
        "structured_output": {
          "$ref": "#/$defs/stateValue"
        },
        "context_window_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "health_http_status",
        "model_list_http_status",
        "model_detail_http_status",
        "proof_request_id",
        "proof_request_http_status",
        "response_model_matches",
        "artifact_version_matches",
        "final_content_nonempty",
        "operation_record_correlated",
        "openai_model_list_http_status",
        "openai_model_list_contains_recommended_model",
        "openai_model_list_contains_resolved_model",
        "messages_model_list_http_status",
        "messages_model_list_contains_recommended_model",
        "messages_model_list_contains_resolved_model",
        "messages_token_count_http_status",
        "messages_token_count_result_valid"
      ],
      "properties": {
        "health_http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "model_list_http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "model_detail_http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "proof_request_id": {
          "type": "string",
          "pattern": "^sx_req_[0-9a-f]{32}$"
        },
        "proof_request_http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "response_model_matches": {
          "type": "boolean"
        },
        "artifact_version_matches": {
          "type": "boolean"
        },
        "final_content_nonempty": {
          "type": "boolean"
        },
        "operation_record_correlated": {
          "type": "boolean"
        },
        "openai_model_list_http_status": {
          "type": ["integer", "null"],
          "minimum": 100,
          "maximum": 599
        },
        "openai_model_list_contains_recommended_model": {
          "type": ["boolean", "null"]
        },
        "openai_model_list_contains_resolved_model": {
          "type": ["boolean", "null"]
        },
        "messages_model_list_http_status": {
          "type": ["integer", "null"],
          "minimum": 100,
          "maximum": 599
        },
        "messages_model_list_contains_recommended_model": {
          "type": ["boolean", "null"]
        },
        "messages_model_list_contains_resolved_model": {
          "type": ["boolean", "null"]
        },
        "messages_token_count_http_status": {
          "type": ["integer", "null"],
          "minimum": 100,
          "maximum": 599
        },
        "messages_token_count_result_valid": {
          "type": ["boolean", "null"]
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_result",
        "rollback_result",
        "retirement_result",
        "service_left_running",
        "service_left_ready",
        "current_receipt_updated"
      ],
      "properties": {
        "promotion_result": {
          "$ref": "#/$defs/nullableString"
        },
        "rollback_result": {
          "$ref": "#/$defs/nullableString"
        },
        "retirement_result": {
          "$ref": "#/$defs/nullableString"
        },
        "service_left_running": {
          "type": "boolean"
        },
        "service_left_ready": {
          "type": "boolean"
        },
        "current_receipt_updated": {
          "type": "boolean"
        }
      }
    }
  }
}
