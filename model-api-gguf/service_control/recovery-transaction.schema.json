{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system-x.service-recovery-transaction.v1",
  "title": "System X Service Recovery Transaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recovery_transaction_id",
    "profile_identity",
    "desired_state_generation",
    "detected_utc",
    "completed_utc",
    "primary_reason_code",
    "trigger_observation",
    "attempt_ordinal",
    "delay_applied_seconds",
    "selected_action",
    "controller_reconciliation_results",
    "controller_start_stop_results",
    "pre_identities",
    "post_identities",
    "readiness_transitions",
    "authenticated_proof_request_id",
    "outcome",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "system-x.service-recovery-transaction.v1"},
    "recovery_transaction_id": {"type": "string", "minLength": 1},
    "profile_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "desired_state_generation": {"type": "integer", "minimum": 1},
    "detected_utc": {"type": "string", "minLength": 1},
    "completed_utc": {"type": ["string", "null"]},
    "primary_reason_code": {"type": "string", "minLength": 1},
    "trigger_observation": {"type": "object"},
    "attempt_ordinal": {"type": "integer", "minimum": 1},
    "delay_applied_seconds": {"type": "number", "minimum": 0},
    "selected_action": {"type": "string", "minLength": 1},
    "controller_reconciliation_results": {"type": "array", "items": {"type": "object"}},
    "controller_start_stop_results": {"type": "array", "items": {"type": "object"}},
    "pre_identities": {"type": "object"},
    "post_identities": {"type": "object"},
    "readiness_transitions": {"type": "array", "items": {"type": "object"}},
    "authenticated_proof_request_id": {"type": ["string", "null"]},
    "outcome": {"enum": ["RECOVERED", "FAILED", "FAIL_CLOSED", "CANCELLED_BY_STOPPED", null]},
    "error": {"type": ["object", "null"]}
  }
}
