{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system-x.service-desired-state.v1",
  "title": "System X Service Desired State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_identity",
    "desired_state",
    "generation",
    "updated_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "system-x.service-desired-state.v1"
    },
    "profile_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "desired_state": {
      "enum": [
        "RUNNING",
        "STOPPED"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "updated_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  }
}
