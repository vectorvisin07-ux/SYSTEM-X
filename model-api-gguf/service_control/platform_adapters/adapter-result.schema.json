{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system-x.platform-service-adapter-result.v1",
  "title": "System X Platform Service Adapter Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "ok",
    "reason_code",
    "message",
    "timestamp_utc",
    "adapter_identity",
    "adapter_version",
    "configuration_identity",
    "registered",
    "enabled",
    "active",
    "automatic_activation_supported",
    "profile_identity",
    "desired_state",
    "desired_state_generation",
    "manifest_path",
    "status_path",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "system-x.platform-service-adapter-result.v1"
    },
    "operation": {
      "enum": [
        "identify",
        "validate",
        "register",
        "enable",
        "disable",
        "start",
        "stop",
        "restart",
        "status",
        "unregister",
        "capability",
        "configuration",
        "supervisor-entrypoint"
      ]
    },
    "ok": {"type": "boolean"},
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "message": {"type": "string", "maxLength": 4096},
    "timestamp_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "adapter_identity": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "configuration_identity": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "registered": {"type": "boolean"},
    "enabled": {"type": "boolean"},
    "active": {"type": "boolean"},
    "automatic_activation_supported": {"type": "boolean"},
    "profile_identity": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "desired_state": {
      "enum": ["RUNNING", "STOPPED", null]
    },
    "desired_state_generation": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "manifest_path": {"type": ["string", "null"]},
    "status_path": {"type": ["string", "null"]},
    "data": {"type": "object"}
  }
}
